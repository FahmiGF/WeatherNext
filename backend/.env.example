# WeatherNext AI - Backend Configuration
# Copy this file to .env and adjust values

# Database
DATABASE_URL=sqlite+aiosqlite:///./weathernext.db

# BMKG Data Source
BMKG_BASE_URL=https://data.bmkg.go.id/DataMKG/MEWS/DigitalForecast

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true
RELOAD=true

# AI Model Placeholders (Phase 2+)
WEATHERNEXT3_API_KEY=
WEATHERNEXT3_ENDPOINT=
TIMESFM3_API_KEY=
TIMESFM3_ENDPOINT=

# Chatbot (Phase 2+)
LLM_API_KEY=
LLM_MODEL=

# App
APP_NAME=WeatherNext AI
APP_VERSION=1.0.0
DEFAULT_CITY=Surabaya
DEFAULT_PROVINCE=JawaTimur
